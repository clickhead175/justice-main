{
  "name": "collision-justice/intake-review",
  "type": "project",
  "description": "Collision Justice intake and lead management application",
  "require": {
    "php": "^8.2",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "barryvdh/laravel-dompdf": "^3.1",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "laravel/pint": "^1.21",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php artisan test",
    "format": "pint"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
